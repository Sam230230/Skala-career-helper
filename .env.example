# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요.
#   PowerShell:  Copy-Item .env.example .env
# .env 는 .gitignore 에 등록되어 깃허브에 올라가지 않습니다.

# --- OpenAI (필수) ---
# platform.openai.com > API Keys 에서 발급
OPENAI_API_KEY=sk-여기에_본인_키_입력
OPENAI_MODEL_NAME=openai/gpt-4o-mini

# --- 실시간 채용 검색 (선택) ---
# serper.dev 무료 발급. 없어도 실행됩니다(채용 수치는 '데이터 확인 불가'로 표기).
SERPER_API_KEY=

# --- CrewAI 텔레메트리/트레이싱 비활성화 ---
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_TRACING_ENABLED=false
